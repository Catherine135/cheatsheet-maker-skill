{
  "title": "Cheat Sheet Style Demo",
  "paragraphs": [
    {
      "role": "major",
      "text": "Chapter 1 Structure",
      "chapter_id": "style"
    },
    {
      "role": "topic",
      "text": "I. Lecture framework"
    },
    {
      "role": "concept",
      "text": "1. Start from the Outline"
    },
    {
      "runs": [
        {
          "role": "body",
          "text": "(1) Use lecture topics as the main structure; "
        },
        {
          "role": "rule",
          "text": "keep the source scope"
        },
        {
          "role": "body",
          "text": "."
        }
      ]
    },
    {
      "runs": [
        {
          "role": "body",
          "text": "(2) "
        },
        {
          "role": "term",
          "text": "Definition:"
        },
        {
          "role": "body",
          "text": " short explanation with the essential condition."
        }
      ]
    },
    {
      "runs": [
        {
          "role": "circle",
          "text": "①"
        },
        {
          "role": "body",
          "text": " First supporting point with a concise explanation."
        }
      ]
    },
    {
      "runs": [
        {
          "role": "circle",
          "text": "②"
        },
        {
          "role": "body",
          "text": " Second point at the same logical level."
        }
      ]
    },
    {
      "runs": [
        {
          "role": "circle",
          "text": "③"
        },
        {
          "role": "body",
          "text": " Keep labels and conditions easy to find."
        }
      ]
    },
    {
      "role": "concept",
      "text": "2. Emphasis"
    },
    {
      "runs": [
        {
          "role": "term",
          "text": "Term:"
        },
        {
          "role": "body",
          "text": " regular English explanation; "
        },
        {
          "role": "rule",
          "text": "deciding condition"
        },
        {
          "role": "body",
          "text": " in red bold."
        }
      ]
    },
    {
      "role": "body",
      "text": "Use concise annotations only when they improve clarity."
    },
    {
      "role": "topic",
      "text": "II. One topic, direct points"
    },
    {
      "role": "body",
      "text": "1. No repeated title when there is only one topic."
    },
    {
      "role": "body",
      "text": "2. Numbering follows the actual relationships."
    },
    {
      "role": "body",
      "text": "3. Same-level points use the same level."
    },
    {
      "role": "major",
      "text": "Chapter 2 Code",
      "chapter_id": "code",
      "column_break_before": true
    },
    {
      "role": "topic",
      "text": "I. Syntax and explanation"
    },
    {
      "role": "concept",
      "text": "1. Editable templates"
    },
    {
      "runs": [
        {
          "role": "body",
          "text": "(1) "
        },
        {
          "role": "term",
          "text": "Example:"
        },
        {
          "role": "body",
          "text": " fixed syntax and replaceable names."
        }
      ]
    },
    {
      "runs": [
        {
          "role": "circle",
          "text": "①"
        },
        {
          "role": "body",
          "text": " Syntax:"
        }
      ],
      "keep_next": true
    },
    {
      "code_template": "SELECT {{column_name}}\nFROM {{table_name}}\nWHERE {{condition}};"
    },
    {
      "runs": [
        {
          "role": "circle",
          "text": "②"
        },
        {
          "role": "body",
          "text": " Black: fixed syntax. Gray: names, parameters and values."
        }
      ]
    },
    {
      "role": "concept",
      "text": "2. A method core"
    },
    {
      "runs": [
        {
          "role": "term",
          "text": "Method 1 — core token: "
        },
        {
          "role": "body",
          "text": "brief idea, then code."
        }
      ]
    },
    {
      "runs": [
        {
          "role": "code",
          "text": "SELECT "
        },
        {
          "role": "code_core",
          "text": "MAX"
        },
        {
          "role": "code",
          "text": "("
        },
        {
          "role": "identifier",
          "text": "value"
        },
        {
          "role": "code",
          "text": ") FROM "
        },
        {
          "role": "identifier",
          "text": "table_name"
        },
        {
          "role": "code",
          "text": ";"
        }
      ]
    },
    {
      "role": "body",
      "text": "Only the distinguishing token uses pale-blue text."
    },
    {
      "role": "topic",
      "text": "II. A short template"
    },
    {
      "runs": [
        {
          "role": "body",
          "text": "(1) "
        },
        {
          "role": "term",
          "text": "Renaming:"
        },
        {
          "role": "body",
          "text": " a simple definition can lead directly to code."
        }
      ]
    },
    {
      "code_template": "SELECT {{column_name}} AS {{output_name}}\nFROM {{table_name}};"
    },
